{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "node-release-notes",
  "title": "Node Release Notes",
  "description": "Quickly browse and access detailed information of Node.js versions. Find release notes, publication dates, and documentation links for any Node.js version. Ideal for developers and sysadmins to stay informed about Node.js updates and ensure compatibility with their projects.",
  "icon": "assets/app-icon.png",
  "version": "0.1.0",
  "author": "almatkai",
  "categories": ["Developer Tools"],
  "license": "MIT",
  "keywords": [
    "explorer",
    "javascript",
    "js",
    "list",
    "lts",
    "node",
    "release",
    "version"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Node Versions",
      "description": "Quickly browse and access detailed information of Node.js versions",
      "mode": "view",
      "keywords": [
        "browse",
        "current",
        "detail",
        "javascript",
        "js",
        "latest",
        "lts",
        "release",
        "version"
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "1.12.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.node-release-notes",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/node-release-notes",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/node-release-notes",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
